projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_KJOM_SalesOrder alias SalesOrder
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Items { create; with draft; }

}

define behavior for ZC_KJOM_SalesOrderItem alias SalesOrderItem
{
  use update;
  use delete;

  use association _SalesOrder { with draft; }
}