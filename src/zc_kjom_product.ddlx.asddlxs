      {
        position: 30,
        label: 'Product Group'
      }
    ],
    selectionField: [
      {
        position: 20
      }
    ],
    fieldGroup: [
      {
        qualifier: 'General',
        position: 30,
        label: 'Product Group'
      }
    ]
