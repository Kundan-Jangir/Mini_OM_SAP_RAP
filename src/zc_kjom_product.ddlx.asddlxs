@Metadata.layer: #CORE

@UI: {
  headerInfo: {
    typeName: 'Product',
    typeNamePlural: 'Products',
    title: {
      type: #STANDARD,
      value: 'ProductName'
    },
    description: {
      type: #STANDARD,
      value: 'Product'
    },
    typeImageUrl: 'sap-icon://product'
  },
  presentationVariant: [
    {
      sortOrder: [
        {
          by: 'ProductName',
          direction: #ASC
        }
      ],
      visualizations: [
        {
          type: #AS_LINEITEM
        }
      ]
    }
  ]
}

annotate entity ZC_KJOM_Product with
{
  @UI.facet: [
    {
      id: 'HeaderStatus',
      purpose: #HEADER,
      type: #DATAPOINT_REFERENCE,
      targetQualifier: 'ProductStatus',
      label: 'Product Status',
      position: 10
    },
    {
      id: 'HeaderPrice',
      purpose: #HEADER,
      type: #DATAPOINT_REFERENCE,
      targetQualifier: 'StandardPrice',
      label: 'Standard Price',
      position: 20
    },
    {
      id: 'HeaderStock',
      purpose: #HEADER,
      type: #DATAPOINT_REFERENCE,
      targetQualifier: 'AvailableStock',
      label: 'Available Stock',
      position: 30
    },
    {
      id: 'GeneralInformation',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'General',
      label: 'General Information',
      position: 10
    },
    {
      id: 'PricingInformation',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Pricing',
      label: 'Pricing and Tax',
      position: 20
    },
    {
      id: 'InventoryInformation',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Inventory',
      label: 'Inventory',
      position: 30
    },
    {
      id: 'AdministrationInformation',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Administration',
      label: 'Administrative Information',
      position: 40
    }
  ]

  @UI: {
    lineItem: [
      {
        position: 10,
        importance: #HIGH,
        label: 'Product ID'
      }
    ],
    identification: [
      {
        position: 10,
        label: 'Product ID'
      }
    ],
    selectionField: [
      {
        position: 10
      }
    ],
    fieldGroup: [
      {
        qualifier: 'General',
        position: 10,
        label: 'Product ID'
      }
    ]
  }
  Product;

  @UI: {
    lineItem: [
      {
        position: 20,
        importance: #HIGH,
        label: 'Product Name'
      }
    ],
    identification: [
      {
        position: 20,
        label: 'Product Name'
      }
    ],
    fieldGroup: [
      {
        qualifier: 'General',
        position: 20,
        label: 'Product Name'
      }
    ]
  }
