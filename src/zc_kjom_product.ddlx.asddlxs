  @UI: {
    lineItem: [
      {
        position: 40,
        label: 'Base Unit'
      }
    ],
    fieldGroup: [
      {
        qualifier: 'General',
        position: 40,
        label: 'Base Unit'
      }
    ]
  }
  BaseUnit;

  @UI: {
    fieldGroup: [
      {
        qualifier: 'Pricing',
        position: 10,
